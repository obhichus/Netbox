# Verze obrazu pro offline balicek. Meni se jen tady, skripty ctou odsud.
# Musi odpovidat tomu, co bezi na puvodnim stroji (NetBox 4.6.10, ipfabric_netbox 6.1.0),
# jinak nepujde obnovit zaloha databaze.

NETBOX_BASE_IMAGE=docker.io/netboxcommunity/netbox:v4.6.10-5.0.2
NETBOX_IMAGE=localhost/netbox-ipfabric:4.6.10
POSTGRES_IMAGE=docker.io/library/postgres:18-alpine
VALKEY_IMAGE=docker.io/valkey/valkey:9.1-alpine

# Cilova architektura RHEL9 serveru
ARCH=amd64

# Port, na kterem bude NetBox na RHEL9 dostupny (http://<server>:8000)
NETBOX_PORT=8000

# Batfish (analyza konfiguraci firewallu, priprava na navrhy zmen pravidel). Volitelne.
BATFISH_IMAGE=docker.io/batfish/allinone:latest

# Vychozi verze IP Fabricu (major.minor), pro kterou se do obrazu nainstaluje SDK.
# Demo IP Fabric bezi na 7.9, SZ ma 7.5. Na RHEL9 se meni offline: deploy/configure-ipfabric.py
IPF_VERSION=${IPF_VERSION:-7.9}
