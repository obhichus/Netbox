[Unit]
Description=NetBox - Valkey (fronta uloh)

[Container]
ContainerName=netbox-redis
Image=@VALKEY_IMAGE@
Pull=never
Network=netbox.network
Exec=valkey-server /etc/valkey/valkey.conf
Volume=/opt/netbox-offline/env/valkey.conf:/etc/valkey/valkey.conf:ro,Z
Volume=netbox-redis-data.volume:/data

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
